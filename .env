# ============================================================================
# AdViora — Premium Digital Commerce Platform & Partner Hub
# Environment Configuration Template (Copy to .env for local/production use)
# NEVER commit real secrets, private keys, or credentials to version control.
# ============================================================================

# --- Application & Domain Routing ---
NODE_ENV=development
PORT=3000
APP_URL=https://adviora.partnerhub.dpdns.org
ADVIORA_STORE_URL=https://adviora.partnerhub.dpdns.org
ADVIORA_PARTNER_URL=https://partnerhub.dpdns.org

# --- Database Persistence ---
# SQLite database file path for local / single-node persistence
SQLITE_DB_PATH=./data/adviora.sqlite
# Optional PostgreSQL connection string for external managed database deployment
DATABASE_URL=postgresql://neondb_owner:npg_INuO14pTsKgM@ep-soft-heart-b4astfpn-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth — sign-in for your app
NEON_AUTH_BASE_URL=https://ep-soft-heart-b4astfpn.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth

# --- Security & Authentication ---
# Minimum 32-byte random hex string required in production for HMAC session & CSRF signing
SESSION_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_IN_PRODUCTION
SESSION_TTL_HOURS=24

# --- Bootstrap Administrator Account ---
# Used by server bootstrap / seed CLI to create or rotate the initial ADMIN account.
# In production, set ADMIN_FORCE_PASSWORD_ROTATION=Fajriii3
ADMIN_BOOTSTRAP_USERNAME=admin_adviora
ADMIN_BOOTSTRAP_EMAIL=admin@adviora.partnerhub.dpdns.org
ADMIN_BOOTSTRAP_PASSWORD=730bce08b6b75085a1e14ce84bdaaa707d41aab7c00ea8f22649459006f3237a
ADMIN_BOOTSTRAP_WHATSAPP=6281200000001
ADMIN_FORCE_PASSWORD_ROTATION=false

# --- QRIS Payment Gateway Configuration ---
# Modes: UNCONFIGURED (blocks public checkout safely) | DYNAMIC_API | STATIC_VERIFIED_WEBHOOK | SANDBOX_SIMULATOR
QRIS_PROVIDER_MODE=SANDBOX_SIMULATOR
QRIS_MERCHANT_ID=ID2026ADVIORAMERCHANT
QRIS_MERCHANT_NAME=ADVIORA DIGITAL COMMERCE
QRIS_STATIC_URL=https://i.ibb.co/35f36Bhq/img-5578497211.jpg
# Existing v32 QRIS link (semi-manual mode; buyer submits screenshot for admin review)
QRIS_PAYMENT_LINK=https://i.ibb.co/35f36Bhq/img-5578497211.jpg
QRIS_DYNAMIC_API_URL=https://i.ibb.co/35f36Bhq/img-5578497211.jpg
QRIS_API_KEY=
# Webhook HMAC-SHA256 secret used to verify incoming payment callbacks from payment gateway
QRIS_WEBHOOK_SECRET=CHANGE_ME_QRIS_WEBHOOK_HMAC_SECRET
QRIS_EXPIRY_MINUTES=15

# --- Supplier & Digital Inventory Fulfillment ---
# Modes: LOCAL_VAULT (atomic stock claim from database inventory_items) | HYBRID_SUPPLIER
FULFILLMENT_MODE=LOCAL_VAULT
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_TIMEOUT_MS=10000

# --- WhatsApp Bot v32 (Pterodactyl Integration) ---
# Internal service-to-service endpoint for Pterodactyl WhatsApp Bot v32
WA_BOT_V32_ENABLED=false
WA_BOT_V32_URL=http://127.0.0.1:4032
WA_BOT_V32_SHARED_SECRET=CHANGE_ME_WA_BOT_V32_SHARED_SECRET
WA_BOT_V32_ADMIN_GROUP_JID=
# Admin private WhatsApp JID/number (falls back to WA_ADMIN_JID on the v32 host)
WA_BOT_V32_ADMIN_JID=6285600753349@s.whatsapp.net
WA_BOT_V32_TIMEOUT_MS=8000

# --- Optional AI Studio Runtime ---
GEMINI_API_KEY=MY_GEMINI_API_KEY
